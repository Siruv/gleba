# Base de données PostgreSQL
DATABASE_URL="postgresql://gleba:gleba@localhost:5432/gleba?schema=public"
POSTGRES_USER=gleba
POSTGRES_PASSWORD=gleba
POSTGRES_DB=gleba

# NextAuth.js (authentification)
NEXTAUTH_SECRET="generate-a-secret-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST=true

# Admin initial (pour seed-admin.ts)
ADMIN_EMAIL="admin@gleba.local"
ADMIN_PASSWORD="changeme"
ADMIN_NAME="Administrateur"

# Application
# NODE_ENV est forcé à "production" dans l'image Docker (Dockerfile).
# Mettre "development" uniquement pour `npm run dev` en local hors Docker.
NODE_ENV=production

# Email de notification feedback (laisser vide en self-host si vous lisez
# les retours via l'UI admin ; sinon mettre votre adresse de support)
FEEDBACK_EMAIL=

# SMTP (optionnel — pour envois feedback, reset password, etc.)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Notifications métier par email (résumé quotidien + alertes temps réel)
# Les alertes sont activées par défaut dès que SMTP_HOST/SMTP_USER sont définis.
# NOTIF_ENABLED=false coupe tout (météo temps réel, urgent, résumé).
NOTIF_ENABLED=true
# Heure du résumé quotidien « Quoi faire ce matin ? » (heure locale conteneur, TZ).
NOTIF_RESUME_HEURE=07:00
# Fréquence (minutes) du scan météo temps réel + alertes urgentes (borné 5-1440).
NOTIF_METEO_INTERVAL_MIN=30
# Notifications push navigateur — générer les clés : npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@example.com
# Test des scripts scripts/test-notif-*.ts depuis l'hôte (optionnel)
TEST_DATABASE_URL=

# Ollama Cloud (assistant chat — optionnel, désactivé par défaut côté public)
OLLAMA_API_KEY=
OLLAMA_MODEL=nemotron-3-nano:30b

# Agents Paperclip des modes Extra et Support (clés privées côté serveur)
GLEBA_PAPERCLIP_API_URL=
GLEBA_PAPERCLIP_COMPANY_ID=
GLEBA_PAPERCLIP_NORMAL_AGENT_ID=
GLEBA_PAPERCLIP_NORMAL_AGENT_KEY=
GLEBA_PAPERCLIP_ADVANCED_AGENT_ID=
GLEBA_PAPERCLIP_ADVANCED_AGENT_KEY=
GLEBA_PAPERCLIP_SUPPORT_AGENT_ID=
GLEBA_PAPERCLIP_SUPPORT_AGENT_KEY=
GLEBA_PAPERCLIP_SUPPORT_TICKET_ASSIGNEE_ID=
